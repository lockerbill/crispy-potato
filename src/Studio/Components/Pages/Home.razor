@page "/"
@attribute [Authorize]
@inject ProjectService Projects
@inject SettingsService Settings
<PageTitle>Frame Studio · @Ui.T("Dự án", "Projects")</PageTitle>
<div class="page-heading"><div><p class="eyebrow">LET'S MAKE SOMETHING WORTH WATCHING</p><h1>@Ui.T("Câu chuyện tiếp theo của anh.", "Your next story starts here.")</h1><p class="muted">@Ui.T("Một nơi để lên ý tưởng, tạo nội dung và đưa video lên YouTube.", "One place to ideate, create, and bring your videos to YouTube.")</p></div><a class="button primary" href="/new">＋ @Ui.T("Tạo video mới", "Create a video")</a></div>
<section class="hero-panel">
    <div class="hero-copy"><span class="pill">IDEA → VIDEO</span><h2>@Ui.T("Ý tưởng của anh.", "Your idea.")<br /><span>@Ui.T("Một studio hoàn chỉnh.", "An entire studio.")</span></h2><p>@Ui.T("Chọn công cụ cho từng bước. Làm chủ nội dung, chất lượng và ngân sách.", "Choose the tools for every step. Own your content, quality, and budget.")</p><a href="/new" class="button light">@Ui.T("Bắt đầu sáng tạo", "Start creating") <span>↗</span></a><div class="hero-formats"><span>▯ YouTube Shorts</span><span>▭ @Ui.T("Video dài", "Long-form")</span><span>VI / EN</span></div></div>
    <div class="hero-art" aria-hidden="true"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="film-card rear"><span>FRAME 02</span><div class="abstract-landscape"></div></div><div class="film-card front"><div class="film-top">YOUR STORY <span>● REC</span></div><div class="abstract-sun"></div><div class="abstract-mountain"></div><div class="play-disc">▶</div><div class="art-caption">MAKE IT <strong>YOURS.</strong></div><div class="film-time">00:00:01 <span>9:16</span></div></div><div class="floating-tag"><span>✦</span> @Ui.T("Sáng tạo không giới hạn", "Made for your imagination")</div></div>
</section>
<div class="stat-grid"><div class="stat-card"><span>@Ui.T("Tổng dự án", "Total projects")</span><strong>@items.Count.ToString("D2")</strong><small>@Ui.T("Câu chuyện đang phát triển", "Stories in the making")</small></div><div class="stat-card"><span>@Ui.T("Video đã dựng", "Rendered videos")</span><strong>@items.Count(p => p.VideoAssetId is not null).ToString("D2")</strong><small>@Ui.T("Sẵn sàng để xem lại", "Ready for a review")</small></div><div class="stat-card"><span>@Ui.T("Provider đã cấu hình", "Configured providers")</span><strong>@configured.ToString("D2")<em>/ @ProviderCatalog.All.Length</em></strong><small><a href="/settings">@Ui.T("Quản lý kết nối", "Manage connections") ↗</a></small></div><div class="stat-card"><span>@Ui.T("Đã đăng YouTube", "Published to YouTube")</span><strong>@items.Count(p => p.YoutubeVideoId is not null).ToString("D2")</strong><small>@Ui.T("Luôn có bước duyệt cuối", "Always with your final approval")</small></div></div>
<div class="section-heading"><div><h2>@Ui.T("Dự án của anh", "Your projects") <span class="count">@items.Count</span></h2><p class="muted">@Ui.T("Tiếp tục câu chuyện đang dang dở hoặc bắt đầu một điều mới.", "Pick up where you left off, or start something new.")</p></div><input aria-label="Search projects" class="search-input" placeholder="@Ui.T("Tìm dự án…", "Find a project…")" @bind="search" @bind:event="oninput" /></div>
@if (items.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">▧<span>＋</span></div><h3>@Ui.T("Khung hình đầu tiên đang chờ anh", "Your first frame is waiting")</h3><p>@Ui.T("Bắt đầu từ một ý tưởng. Studio sẽ giúp anh đi qua từng bước.", "Start with an idea. Studio will guide you through every step.")</p><a class="button secondary" href="/new">＋ @Ui.T("Tạo dự án đầu tiên", "Create your first project")</a><a class="text-link" href="/providers">@Ui.T("Khám phá các provider", "Explore the providers") →</a></div>
}
else
{
    <div class="project-grid">@foreach (var p in items.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase))) { <a class="project-card" href="@($"/studio/{p.Id}")"><div class="project-cover">@if (p.ThumbnailAssetId is not null) { <img src="@($"/media/{p.ThumbnailAssetId}")" alt="" /> } else { <div class="project-cover-pattern"><span>▶</span></div> }<span class="format-badge">@(p.Format == VideoFormat.Short ? "SHORTS · 9:16" : "YOUTUBE · 16:9")</span><span class="duration-badge">@TimeSpan.FromSeconds(p.TargetSeconds).ToString(@"mm\:ss")</span></div><div class="project-details"><small>@(p.Language == "vi" ? "TIẾNG VIỆT" : "ENGLISH") <span>· @p.Mode</span></small><h3>@p.Name</h3><div class="progress-track"><span style="width:@(p.Steps.Values.Count(s => s.Status == StepStatus.Approved) * 10)%"></span></div><div class="project-meta"><span>@p.Steps.Values.Count(s => s.Status == StepStatus.Approved)/10 @Ui.T("bước", "steps")</span><span>@p.Budget.ToString("0.##") @p.Currency</span></div></div></a> }</div>
}
@code {
    List<Project> items = []; string search = ""; int configured;
    protected override async Task OnInitializedAsync() { items = await Projects.List(); foreach (var provider in ProviderCatalog.All) { var cfg = await Settings.GetProvider(provider.Id); if (cfg.CheckedAt is not null && cfg.LastCheck?.StartsWith("FAIL:", StringComparison.Ordinal) != true) configured++; } }
}
