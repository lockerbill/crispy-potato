@page "/studio/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ProjectService Projects
@inject AssetStore AssetFiles
@inject MediaEngine Media
@inject SettingsService Settings
@inject ProviderRegistry Registry
@inject ProviderConnectionService Connections
@inject YouTubeService YouTube
<PageTitle>@(project?.Name ?? "Studio") · Frame Studio</PageTitle>
@if (project is null) { <div class="empty-state">@Ui.T("Đang tải studio…", "Loading studio…")</div> }
else
{
    <div class="editor-heading"><div><a class="back-link" href="/">← @Ui.T("Dự án", "Projects")</a><h1>@project.Name <span class="pill">@(project.Format == VideoFormat.Short ? "SHORTS" : "LONG-FORM")</span></h1><div class="editor-subtitle"><span>@(project.Language == "vi" ? "Tiếng Việt" : "English")</span><span>·</span><span>@project.Width × @project.Height</span><span>·</span><span>@project.TargetSeconds s @Ui.T("mục tiêu", "target")</span><span>·</span><span>@(project.Mode == RunMode.Automatic ? Ui.T("Tự động", "Automatic") : Ui.T("Duyệt từng bước", "Review each step"))</span></div></div><div class="button-row"><button class="button secondary" @onclick="Refresh" disabled="@busy">↻ @Ui.T("Tải lại", "Refresh")</button><button class="button primary" @onclick="RunNext" disabled="@(busy || running || dirty)">▶ @Ui.T("Tiếp tục quy trình", "Continue workflow")</button></div></div>
    @if (message is not null) { <div role="status" class="alert @(error ? "error" : "success")">@message</div> }
    @if (dirty) { <div class="unsaved-banner">● @Ui.T("Có thay đổi chưa lưu. Lưu nội dung đang sửa trước khi chạy.", "You have unsaved changes. Save your edits before running.")</div> }
    <div class="budget-strip"><span><span class="pulse-dot"></span>@Ui.T("Ngân sách dự án", "Project budget")</span><div class="budget-meter"><i style="width:@BudgetPercent%"></i></div><strong>$@spent.ToString("0.######") <small>/ $@project.BudgetUsd.ToString("0.##")</small></strong><span class="muted">@Ui.T("đã dùng / đang giữ", "spent / reserved")</span><button class="text-button" @onclick='() => tab = "budget"'>@Ui.T("Chi tiết", "Details") ↗</button></div>
    <div class="studio-layout">
        <aside class="pipeline-panel panel"><p class="eyebrow">PRODUCTION PIPELINE</p><h3>@Ui.T("Từng bước, rõ ràng.", "One clear step at a time.")</h3><div class="pipeline-steps">@foreach (var s in Pipeline.Order) { var step = project.Steps[s]; <button disabled="@busy" class="pipeline-step @(active == s ? "active" : "")" @onclick="() => SelectStage(s)"><span class="pipeline-number @step.Status.ToString().ToLowerInvariant()">@(step.Status == StepStatus.Approved ? "✓" : ((int)s + 1).ToString("D2"))</span><span><strong>@Ui.StageName(s)</strong><small>@Ui.Status(step.Status)</small></span>@if (step.Status == StepStatus.Running) { <span class="spinner"></span> }</button> }</div><div class="pipeline-footer"><span>▶ YouTube</span><small>@Ui.T("Chỉ đăng sau khi anh duyệt", "Only publish after your approval")</small></div></aside>
        <div class="studio-main">
            <div class="tab-bar"><button class="@(tab == "step" ? "active" : "")" @onclick='() => tab = "step"'>@Ui.T("Công đoạn", "Stage")</button><button class="@(tab == "scenes" ? "active" : "")" @onclick='() => tab = "scenes"'>@Ui.T("Các cảnh", "Scenes") <span>@project.Scenes.Count</span></button><button class="@(tab == "preview" ? "active" : "")" @onclick='() => tab = "preview"'>Preview & YouTube</button><button class="@(tab == "budget" ? "active" : "")" @onclick='() => tab = "budget"'>@Ui.T("Chi phí & tác vụ", "Costs & jobs")</button><button class="@(tab == "history" ? "active" : "")" @onclick='() => tab = "history"'>@Ui.T("Phiên bản", "Versions")</button></div>
            @if (tab == "step")
            {
                var step = project.Steps[active]; var provider = ProviderCatalog.Get(step.ProviderId);
                <section class="panel stage-workspace" @oninput="MarkDirty" @onchange="MarkDirty"><div class="section-heading"><div><span class="eyebrow">STEP @(((int)active + 1).ToString("D2")) / 10</span><h2>@Ui.StageName(active)</h2></div><span class="status-badge @step.Status.ToString().ToLowerInvariant()">@Ui.Status(step.Status)</span></div>
                <div class="form-row"><label>Provider<select disabled="@(busy || running)" value="@step.ProviderId" @onchange="e => ChangeProvider(e.Value?.ToString() ?? string.Empty)">@foreach (var candidate in ProviderCatalog.For(active)) { <option value="@candidate.Id">@candidate.Name · @Ui.Tier(candidate.Tier)</option> }</select></label>@if (provider.IsText || provider.Model.Length > 0) { <label>Model<input @bind="step.Model" list="editor-model-options" placeholder="@Ui.T("Để trống để dùng model trong Settings", "Blank uses the Settings model")" /></label> }</div>
                <datalist id="editor-model-options">@foreach (var model in editorModels) { <option value="@model.Id">@model.Name</option> }</datalist>
                @if (provider.SupportsModelDiscovery) { <button class="text-button" disabled="@(busy || running)" @onclick="LoadEditorModels">@Ui.T("Đọc danh sách model", "Load models") ↻</button> }
                @if (active == Stage.Voice && provider.Id != "piper") { <label>@Ui.T("Voice ID (để trống để dùng mặc định)", "Voice ID (blank uses the default)")<input @bind="step.Voice" /></label> }
                <div class="provider-context"><span class="tier @provider.Tier.ToString().ToLowerInvariant()">@Ui.Tier(provider.Tier)</span><p>@Ui.ProviderNotice(provider)</p><a href="@($"/settings?provider={step.ProviderId}")">@Ui.T("Cấu hình", "Configure") ↗</a></div>
                @if (step.Error is not null) { <div class="alert error">@step.Error</div> }
                @switch (active)
                {
                    case Stage.Topic:
                        <label>@Ui.T("Chủ đề đã chọn", "Selected topic")<textarea rows="3" @bind="project.Topic" placeholder="@Ui.T("Để AI đề xuất hoặc nhập chủ đề của anh…", "Ask AI to suggest one, or enter your topic…")"></textarea></label>
                        <button class="button secondary" disabled="@(busy || running)" @onclick="SaveText">@Ui.T("Lưu nội dung chỉnh sửa", "Save edited content")</button>
                        break;
                    case Stage.Title:
                        <label>@Ui.T("Tiêu đề YouTube", "YouTube title")<input maxlength="100" @bind="project.Title" /></label><button class="button secondary" disabled="@(busy || running)" @onclick="SaveText">@Ui.T("Lưu tiêu đề", "Save title")</button>
                        break;
                    case Stage.Description:
                        <label>@Ui.T("Mô tả YouTube", "YouTube description")<textarea rows="9" maxlength="5000" @bind="project.Description"></textarea></label><button class="button secondary" disabled="@(busy || running)" @onclick="SaveText">@Ui.T("Lưu mô tả", "Save description")</button>
                        break;
                    case Stage.Tags:
                        <label>@Ui.T("Tags (phân cách bằng dấu phẩy)", "Tags (comma-separated)")<textarea rows="4" @bind="tagsText"></textarea></label><button class="button secondary" disabled="@(busy || running)" @onclick="SaveText">@Ui.T("Lưu tags", "Save tags")</button>
                        break;
                    case Stage.Script:
                        <div class="stage-explainer"><span>▤</span><h3>@project.Scenes.Count @Ui.T("cảnh trong kịch bản", "scenes in your script")</h3><p>@Ui.T("Tạo kịch bản theo thời lượng mục tiêu, rồi chỉnh lời đọc và mô tả hình ảnh của từng cảnh.", "Generate a script for your target duration, then edit narration and visuals scene by scene.")</p><button class="button secondary" @onclick='() => tab = "scenes"'>@Ui.T("Mở trình sửa cảnh", "Open scene editor") →</button></div>
                        break;
                    case Stage.Voice:
                        <div class="audio-list">@foreach (var s in project.Scenes.Where(s => s.AudioAssetId is not null)) { <div><span>@Ui.T("Cảnh", "Scene") @(project.Scenes.IndexOf(s) + 1) · @s.AudioSeconds.ToString("0.0") s</span><audio controls preload="none" src="@($"/media/{s.AudioAssetId}")"></audio></div> }</div><p class="help">@Ui.T("Thời lượng thực", "Actual duration"): @project.ActualSeconds.ToString("0.0") s / @project.MaxSeconds s</p>
                        break;
                    case Stage.Media:
                        <div class="scene-media-grid">@foreach (var s in project.Scenes) { <div>@if (s.MediaAssetId is not null) { <MediaPreview AssetId="s.MediaAssetId" MediaAssets="mediaAssets" /> } else { <div class="media-placeholder">▧</div> }<span>@Ui.T("Cảnh", "Scene") @(project.Scenes.IndexOf(s) + 1)</span></div> }</div><button class="button secondary" @onclick='() => tab = "scenes"'>@Ui.T("Thay media từng cảnh", "Replace scene media") →</button>
                        break;
                    case Stage.Captions:
                        <label>@Ui.T("Kiểu phụ đề", "Caption style")<select @bind="project.CaptionStyle"><option value="karaoke">@Ui.T("Tô sáng từ đang đọc", "Highlight the current word")</option><option value="word">@Ui.T("Hiện từng từ", "One word at a time")</option></select></label><div class="caption-editor"><div class="caption-row header"><span>@Ui.T("Từ", "Word")</span><span>@Ui.T("Bắt đầu (s)", "Start (s)")</span><span>@Ui.T("Kết thúc (s)", "End (s)")</span></div>@for (var i = 0; i < project.Captions.Count; i++) { var index = i; var cue = project.Captions[i]; <div class="caption-row"><input aria-label="Caption word" value="@cue.Text" @onchange="e => SetCue(index, e.Value?.ToString() ?? string.Empty, null, null)" /><input aria-label="Caption start" type="number" step="0.01" value="@MediaEngine.Number(cue.Start)" @onchange="e => SetCueNumber(index, e.Value?.ToString(), true)" /><input aria-label="Caption end" type="number" step="0.01" value="@MediaEngine.Number(cue.End)" @onchange="e => SetCueNumber(index, e.Value?.ToString(), false)" /></div> }</div><button class="button secondary" disabled="@(busy || running)" @onclick="SaveCaptions">@Ui.T("Lưu phụ đề", "Save captions")</button>
                        break;
                    case Stage.Thumbnail:
                        @if (project.ThumbnailAssetId is not null) { <img class="thumbnail-preview" src="@($"/media/{project.ThumbnailAssetId}")" alt="Thumbnail" /> } else { <div class="stage-explainer"><span>▧</span><h3>@Ui.T("Ấn tượng từ khung hình đầu tiên", "Make the first impression count")</h3><p>@Ui.T("Tạo ảnh nền bằng provider đã chọn và ghép tiêu đề bằng template hỗ trợ tiếng Việt.", "Generate a background with your provider and add a title with Vietnamese-friendly typography.")</p></div> }
                        break;
                    case Stage.Render:
                        <div class="stage-explainer"><span>▶</span><h3>@Ui.T("Đưa các cảnh thành câu chuyện", "Bring the scenes together")</h3><p>@project.Scenes.Count @Ui.T("cảnh", "scenes") · @project.ActualSeconds.ToString("0.0") s · @project.Width × @project.Height · 30 fps</p><button class="button secondary" @onclick='() => tab = "preview"'>@Ui.T("Mở preview & xuất bản", "Open preview & publish") →</button></div>
                        break;
                }
                <div class="quote-row"><button class="text-button" @onclick="EstimateStage">@Ui.T("Ước tính chi phí bước này", "Estimate this step") ↗</button>@if (stepQuote is not null) { <p class="help">@stepQuote</p> }</div><div class="stage-actions"><button class="button secondary" @onclick="SaveConfig" disabled="@(busy || running)">@Ui.T("Lưu cấu hình", "Save configuration")</button><button class="button primary" @onclick="RunStage" disabled="@(busy || running || dirty)">▶ @Ui.T("Chạy bước này", "Run this step")</button>@if (step.Status == StepStatus.AwaitingReview) { <button class="button approve" @onclick="Approve" disabled="@(busy || running || dirty)">✓ @Ui.T("Duyệt kết quả", "Approve result")</button> }</div>
                </section>
            }
            else if (tab == "scenes")
            {
                <section class="panel" @oninput="MarkDirty" @onchange="MarkDirty"><div class="section-heading"><div><h2>@Ui.T("Chỉnh sửa theo cảnh", "Scene editor")</h2><p class="muted">@Ui.T("Sửa lời đọc hoặc thứ tự cảnh sẽ yêu cầu cập nhật các bước phía sau.", "Changing narration or scene order requires regenerating dependent stages.")</p></div><button class="button secondary" disabled="@running" @onclick="AddScene">＋ @Ui.T("Thêm cảnh", "Add scene")</button></div>
                @for (var i = 0; i < project.Scenes.Count; i++) { var index = i; var scene = project.Scenes[i]; <article class="scene-editor" @key="scene.Id"><div class="scene-editor-head"><span class="scene-index">@((i + 1).ToString("D2"))</span><strong>@Ui.T("Cảnh", "Scene") @(i + 1)</strong><div class="button-row"><button class="icon-button" title="Move up" disabled="@(i == 0 || running)" @onclick="() => MoveScene(index, -1)">↑</button><button class="icon-button" title="Move down" disabled="@(i == project.Scenes.Count - 1 || running)" @onclick="() => MoveScene(index, 1)">↓</button><button class="icon-button danger" title="Remove scene" disabled="@running" @onclick="() => RemoveScene(index)">×</button></div></div><div class="scene-edit-grid"><div class="scene-visual">@if (scene.MediaAssetId is not null) { <MediaPreview AssetId="scene.MediaAssetId" MediaAssets="mediaAssets" /> } else { <div class="media-placeholder">▧<span>@Ui.T("Chưa có media", "No media yet")</span></div> }<label class="upload-label">↑ @Ui.T("Tải ảnh/clip lên", "Upload image/clip")<InputFile OnChange="e => UploadMedia(e, scene.Id)" accept="image/png,image/jpeg,image/webp,video/mp4" disabled="@(running || busy)" /></label><select aria-label="Select scene media" @bind="scene.MediaAssetId"><option value="">@Ui.T("Chọn từ thư viện dự án", "Choose project media")</option>@foreach (var a in mediaAssets.Where(a => a.ContentType.StartsWith("image/") || a.ContentType.StartsWith("video/"))) { <option value="@a.Id">@a.FileName · @a.Id[..6]</option> }</select><small class="media-credit">@scene.Attribution</small></div><div><label>@Ui.T("Lời đọc", "Narration")<textarea rows="3" @bind="scene.Narration"></textarea></label><label>@Ui.T("Mô tả hình ảnh (tiếng Anh)", "Visual prompt (English)")<textarea rows="2" @bind="scene.VisualPrompt"></textarea></label><div class="form-row"><label>@Ui.T("Thời lượng cảnh (giây)", "Scene duration (seconds)")<input type="number" min="0.1" step="0.1" @bind="scene.DurationSeconds" /></label><label>@Ui.T("Chuyển cảnh", "Transition")<select @bind="scene.Transition"><option value="cut">Cut</option><option value="fade">@Ui.T("Mờ qua đen", "Fade through black")</option></select></label></div>@if (scene.AudioAssetId is not null) { <audio controls preload="none" src="@($"/media/{scene.AudioAssetId}")"></audio><small class="help">@Ui.T("Lời đọc thực", "Narration length"): @scene.AudioSeconds.ToString("0.0") s</small> }</div></div></article> }
                <div class="button-row sticky-actions"><button class="button primary" disabled="@(busy || running)" @onclick="SaveScenes">@Ui.T("Lưu kịch bản & các cảnh", "Save script & scenes")</button><button class="button secondary" disabled="@(busy || running)" @onclick="SaveSceneMedia">@Ui.T("Lưu lựa chọn media", "Save media selections")</button></div></section>
            }
            else if (tab == "preview")
            {
                <section class="panel"><div class="section-heading"><h2>@Ui.T("Bản dựng của anh", "Your final cut")</h2><span class="pill">1080p · 30 fps</span></div>@if (project.VideoAssetId is not null) { <div class="video-preview"><video controls preload="metadata" src="@($"/media/{project.VideoAssetId}")" poster="@(project.ThumbnailAssetId is null ? null : $"/media/{project.ThumbnailAssetId}")"><track kind="captions" src="@($"/projects/{Id}/export/vtt")" srclang="@project.Language" label="Captions" /></video></div> } else { <div class="preview-empty"><span>▶</span><h3>@Ui.T("Câu chuyện đang được tạo nên", "Your story is taking shape")</h3><p>@Ui.T("Hoàn thành giọng đọc, hình ảnh và phụ đề rồi chạy bước dựng video.", "Complete the voice, visuals, and captions, then run the render step.")</p></div> }<div class="download-bar">@if (project.VideoAssetId is not null) { <a class="button primary" href="@($"/media/{project.VideoAssetId}?download=true")">↓ MP4</a> }@if (project.ThumbnailAssetId is not null) { <a class="button secondary" href="@($"/media/{project.ThumbnailAssetId}?download=true")">↓ Thumbnail</a> }<a class="button secondary" href="@($"/projects/{Id}/export/srt")">SRT</a><a class="button secondary" href="@($"/projects/{Id}/export/vtt")">VTT</a><a class="button secondary" href="@($"/projects/{Id}/export/script")">@Ui.T("Kịch bản", "Script")</a><a class="button secondary" href="@($"/projects/{Id}/export/metadata")">Metadata</a></div></section>
                <section class="panel"><div class="panel-title"><span class="provider-logo youtube">▶</span><div><h2>@Ui.T("Đưa câu chuyện lên YouTube", "Bring your story to YouTube")</h2><p>@Ui.T("Luôn cần duyệt trước khi gửi. Mặc định riêng tư.", "Always requires approval before sending. Private by default.")</p></div></div>@if (project.YoutubeVideoId is not null) { <div class="alert success">@Ui.T("Đã đăng video", "Video uploaded"): <a href="@($"https://www.youtube.com/watch?v={project.YoutubeVideoId}")" target="_blank" rel="noopener noreferrer">@project.YoutubeVideoId ↗</a></div><button class="button secondary" @onclick="RetryThumbnail">@Ui.T("Gửi lại thumbnail", "Retry thumbnail upload")</button> } else { <label>@Ui.T("Trạng thái xuất bản", "Publishing visibility")<select @bind="privacy"><option value="private">@Ui.T("Riêng tư", "Private")</option><option value="unlisted">@Ui.T("Không công khai", "Unlisted")</option><option value="public">@Ui.T("Công khai", "Public")</option></select></label><label class="checkbox-label"><input type="checkbox" @bind="madeForKids" />@Ui.T("Video này dành cho trẻ em", "This video is made for kids")</label><label class="checkbox-label"><input type="checkbox" @bind="uploadApproved" />@Ui.T("Tôi đã xem video, kiểm tra nội dung, quyền sử dụng media và đồng ý đăng với trạng thái đã chọn.", "I reviewed the video, content and media rights, and approve uploading with the selected visibility.")</label><div class="button-row"><button class="button youtube-button" disabled="@(busy || running || !uploadApproved || dirty)" @onclick="Publish">▶ @Ui.T("Duyệt & đăng YouTube", "Approve & upload to YouTube")</button><a href="/settings#youtube" class="text-link">@Ui.T("Kết nối / chọn kênh", "Connect / select channel") ↗</a></div> }</section>
            }
            else if (tab == "budget")
            {
                <section class="panel" @oninput="MarkDirty" @onchange="MarkDirty"><h2>@Ui.T("Ngân sách & quy trình", "Budget & workflow")</h2><div class="form-row"><label>@Ui.T("Trần ngân sách", "Budget limit")<input type="number" min="0" step="0.01" @bind="project.Budget" /></label><label>@Ui.T("Tiền tệ", "Currency")<select @bind="project.Currency"><option>USD</option><option>VND</option></select></label><label>VND / USD<input type="number" min="1" @bind="project.VndPerUsd" /></label></div><label>@Ui.T("Chế độ chạy", "Run mode")<select @bind="project.Mode"><option value="Review">@Ui.T("Duyệt từng bước", "Review each step")</option><option value="Automatic">@Ui.T("Tự động", "Automatic")</option></select></label><button class="button primary" disabled="@(busy || running)" @onclick="SaveConfig">@Ui.T("Lưu cấu hình", "Save configuration")</button><p class="help">@Ui.T("Dự toán không phải hóa đơn. Khoản chưa rõ kết quả vẫn giữ ngân sách cho đến khi anh đối soát với provider.", "Estimates are not invoices. Uncertain charges remain reserved until reconciled against the provider account.")</p></section>
                <section class="panel"><h2>@Ui.T("Lịch sử tác vụ & chi phí", "Jobs & cost ledger")</h2>@if (jobs.Count == 0) { <p class="muted">@Ui.T("Chưa chạy tác vụ nào.", "No jobs yet.")</p> }@foreach (var job in jobs) { var charge = charges.FirstOrDefault(c => c.JobId == job.Id); <article class="job-card"><div class="job-title"><strong>@job.Stage · @job.ProviderId</strong><span class="pill">@job.Status</span></div><small>@DateTimeOffset.FromUnixTimeMilliseconds(job.CreatedAt).ToString("yyyy-MM-dd HH:mm 'UTC'") · @job.Id.ToString()[..8]</small>@if (charge is not null) { <p><strong>$@charge.AmountUsd.ToString("0.######")</strong> <span class="muted">@charge.Status · @charge.PriceVersion</span></p> }@if (job.Error is not null) { <p class="error-text">@job.Error</p> }<div class="button-row">@if (job.Status is "Queued" or "Running") { <button class="button secondary small" @onclick="() => Cancel(job.Id)">@Ui.T("Dừng tác vụ", "Stop job")</button> }@if (job.Status == "NeedsAttention" && job.Checkpoint is not null && (job.Stage == "YouTube" || Registry.Get(job.ProviderId).CanResume(job.Checkpoint))) { <button class="button secondary small" @onclick="() => Resume(job.Id)">@Ui.T("Tiếp tục job đã gửi", "Resume existing job")</button> }@if (job.Status is not ("Running" or "Queued")) { <button class="text-button" @onclick="() => BeginReconcile(job.Id, charge?.AmountUsd ?? 0)">@Ui.T("Đối soát chi phí/kết quả", "Reconcile cost/result")</button> }</div>@if (reconcileId == job.Id) { <div class="reconcile-box"><p>@Ui.T("Kiểm tra dashboard/hóa đơn provider và YouTube trước. Việc xác nhận cho phép tạo tác vụ mới; hãy chắc chắn tác vụ cũ đã được xử lý.", "Check the provider dashboard/invoice and YouTube first. Confirming permits a new job; make sure the old job is accounted for.")</p><label>USD<input type="number" min="0" step="0.000001" @bind="reconcileAmount" /></label><label class="checkbox-label"><input type="checkbox" @bind="reconcileApproved" />@Ui.T("Tôi đã đối soát kết quả và số tiền.", "I verified the result and charge.")</label><button class="button secondary" disabled="@(!reconcileApproved || busy)" @onclick="Reconcile">@Ui.T("Xác nhận đối soát", "Confirm reconciliation")</button></div> }</article> }</section>
            }
            else if (tab == "history")
            {
                <section class="panel"><h2>@Ui.T("Các phiên bản đã lưu", "Saved versions")</h2><p class="help">@Ui.T("Khôi phục nội dung không xóa lịch sử chi phí. Các file media cũ được giữ để phục hồi.", "Restoring content never erases the cost ledger. Previous media files are retained for recovery.")</p>@foreach (var version in history) { <div class="history-row"><span class="version-number">v@version.Version</span><div><strong>@version.Reason</strong><small>@DateTimeOffset.FromUnixTimeMilliseconds(version.CreatedAt).ToString("yyyy-MM-dd HH:mm 'UTC'")</small></div><button class="button secondary small" disabled="@(running || busy || dirty)" @onclick="() => Restore(version.Id)">@Ui.T("Khôi phục", "Restore")</button></div> }</section>
            }
        </div>
    </div>
}
@code {
    [Parameter] public Guid Id { get; set; }
    Project? project; List<AssetRow> mediaAssets = []; List<JobRow> jobs = []; List<ChargeRow> charges = []; List<RevisionRow> history = [];
    string? stepQuote; Stage active = Stage.Topic; string tab = "step"; string tagsText = ""; string? message; bool error; bool busy; bool dirty; bool running; decimal spent;
    string privacy = "private"; bool madeForKids; bool uploadApproved; Guid? reconcileId; decimal reconcileAmount; bool reconcileApproved;
    readonly CancellationTokenSource lifetime = new(); Task? pollTask; IReadOnlyList<ProviderModel> editorModels = [];
    string BudgetPercent => (project!.BudgetUsd <= 0 ? (spent > 0 ? 100 : 0) : Math.Min(100, spent / project.BudgetUsd * 100)).ToString("0.##", CultureInfo.InvariantCulture);
    protected override async Task OnInitializedAsync() { await Load(); pollTask = Poll(); }
    async Task Load() { project = await Projects.Get(Id); jobs = await Projects.Jobs(Id); charges = await Projects.Charges(Id); mediaAssets = await AssetFiles.List(Id); history = await Projects.History(Id); running = jobs.Any(j => j.Status is "Queued" or "Running"); spent = ProjectService.Committed(charges); tagsText = string.Join(", ", project.Tags); }
    async Task Poll() { try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2)); while (await timer.WaitForNextTickAsync(lifetime.Token)) { if (!dirty && !busy) await InvokeAsync(async () => { if (!dirty && !busy) { await Load(); StateHasChanged(); } }); } } catch (OperationCanceledException) { } }
    void MarkDirty() => dirty = true;
    async Task Action(Func<Task> action) { busy = true; error = false; message = null; try { await action(); dirty = false; await Load(); } catch (Exception e) when (e is InvalidOperationException or ProviderException or IOException or HttpRequestException or OperationCanceledException) { error = true; message = e is OperationCanceledException ? Ui.T("Thao tác đã dừng.", "Operation stopped.") : e.Message; } finally { busy = false; } }
    Task Refresh() => Action(async () => { dirty = false; await Load(); });
    void SelectStage(Stage stage) { active = stage; tab = "step"; stepQuote = null; editorModels = []; }
    async Task ChangeProvider(string id)
    {
        if (busy || running) return;
        busy = true; dirty = true; editorModels = []; stepQuote = null;
        try { var cfg = await Settings.GetProvider(id); project!.Steps[active].ProviderId = id; project.Steps[active].Model = cfg.Model; }
        catch (InvalidOperationException e) { error = true; message = e.Message; }
        finally { busy = false; }
    }
    async Task LoadEditorModels()
    {
        busy = true; message = null; error = false;
        try
        {
            var cfg = await Settings.GetProvider(project!.Steps[active].ProviderId);
            editorModels = await Connections.Models(cfg, lifetime.Token);
            message = Ui.T("Nhập model ID trực tiếp nếu model cần dùng không có trong danh sách. Kiểm tra bảng giá Settings cho model đã chọn.", "Enter a model ID directly if it is not listed. Check Settings pricing for the selected model.");
        }
        catch (Exception e) when (e is InvalidOperationException or ProviderException or HttpRequestException or OperationCanceledException) { error = true; message = e is OperationCanceledException ? Ui.T("Yêu cầu đã dừng.", "Request stopped.") : e.Message; }
        finally { busy = false; }
    }
    async Task EstimateStage() { try { if (Pipeline.Dependencies(active).Any(s => !Pipeline.Usable(project!.Steps[s]))) throw new InvalidOperationException(Ui.T("Duyệt các bước đầu vào trước để có dự toán chính xác hơn.", "Approve the input stages first for a meaningful estimate.")); var cfg = await Settings.GetProvider(project!.Steps[active].ProviderId); if (ProviderCatalog.Get(cfg.Id).Tier == ProviderTier.Paid && project.Steps[active].Model.Length > 0 && project.Steps[active].Model != cfg.Model) throw new InvalidOperationException(Ui.T("Cập nhật giá Settings cho đúng model đã chọn.", "Update pricing in Settings for the selected model.")); var cost = BudgetService.Estimate(project, active, cfg); stepQuote = Ui.T("Giữ ngân sách dự kiến: ", "Estimated reservation: ") + "$" + cost.ToString("0.######") + Ui.T(". Không gồm hạ tầng; free tier cần còn quota. Hóa đơn provider là số cuối cùng.", ". Excludes infrastructure; free tiers need remaining quota. Provider invoices are authoritative."); } catch (InvalidOperationException e) { stepQuote = e.Message; } }
    Task SaveConfig() => Action(async () => { project = await Projects.Edit(project!, null, "Update project/provider configuration"); message = Ui.T("Đã lưu cấu hình.", "Configuration saved."); });
    Task RunNext() => Action(async () => { await Projects.RunNext(Id); message = Ui.T("Đã gửi bước tiếp theo vào hàng đợi.", "Next stage queued."); });
    Task RunStage() => Action(async () => { await Projects.Queue(Id, active); message = Ui.T("Đã xếp hàng tác vụ.", "Job queued."); });
    Task Approve() => Action(async () => { await Projects.Approve(Id, active); message = Ui.T("Đã duyệt kết quả. Có thể tiếp tục bước sau.", "Result approved. Continue when ready."); });
    Task SaveText() => Action(async () => { if (active == Stage.Tags) project!.Tags = tagsText.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct().ToList(); var raw = active switch { Stage.Topic => Json.Write(new { topic = project!.Topic }), Stage.Title => Json.Write(new { title = project!.Title }), Stage.Description => Json.Write(new { description = project!.Description }), Stage.Tags => Json.Write(new { tags = project!.Tags }), _ => throw new InvalidOperationException() }; TextProvider.Apply(project!, active, raw); project!.Steps[active].Output = raw; project = await Projects.Edit(project, active, "Edit " + active); message = Ui.T("Đã lưu. Duyệt kết quả để tiếp tục.", "Saved. Approve the result to continue."); });
    void AddScene() { project!.Scenes.Add(new Scene()); dirty = true; }
    void RemoveScene(int i) { project!.Scenes.RemoveAt(i); dirty = true; }
    void MoveScene(int i, int direction) { var s = project!.Scenes[i]; project.Scenes.RemoveAt(i); project.Scenes.Insert(i + direction, s); dirty = true; }
    Task SaveScenes() => Action(async () => { if (project!.Scenes.Count == 0 || project.Scenes.Any(s => string.IsNullOrWhiteSpace(s.Narration))) throw new InvalidOperationException("Mỗi cảnh cần có lời đọc."); project.Steps[Stage.Script].Output = Json.Write(project.Scenes); project = await Projects.Edit(project, Stage.Script, "Edit storyboard"); message = Ui.T("Đã lưu cảnh. Các bước phụ thuộc cần cập nhật và duyệt lại.", "Scenes saved. Dependent stages need updating and review."); });
    Task SaveSceneMedia() => Action(async () => { foreach (var s in project!.Scenes) { if (s.MediaAssetId is null) throw new InvalidOperationException("Chọn media cho từng cảnh trước."); var asset = await AssetFiles.Get(s.MediaAssetId, Id); s.Attribution = asset.Attribution; } project = await Projects.Edit(project, Stage.Media, "Select scene media"); message = Ui.T("Đã lưu media. Duyệt bước Hình ảnh để dùng bản mới.", "Media saved. Approve the media stage to use it."); });
    async Task UploadMedia(InputFileChangeEventArgs e, Guid sceneId) { await Action(async () => { var file = e.File; var extension = Path.GetExtension(file.Name).ToLowerInvariant(); var type = extension switch { ".jpg" or ".jpeg" => "image/jpeg", ".png" => "image/png", ".webp" => "image/webp", ".mp4" => "video/mp4", _ => throw new InvalidOperationException("Chỉ nhận JPG, PNG, WebP hoặc MP4.") }; var path = Path.Combine(AssetFiles.WorkDir(Guid.NewGuid()), "upload" + extension); await using (var stream = file.OpenReadStream(200_000_000, lifetime.Token)) await using (var target = File.Create(path)) await stream.CopyToAsync(target, lifetime.Token); await Media.ValidateMedia(path, lifetime.Token); var asset = await AssetFiles.Add(Id, path, file.Name, type, lifetime.Token); project!.Scenes.Single(s => s.Id == sceneId).MediaAssetId = asset.Id; project = await Projects.Edit(project, Stage.Media, "Upload scene media"); message = Ui.T("Media đã lưu; quyền sử dụng do anh xác nhận.", "Media saved; confirm you have permission to use it."); }); }
    void SetCue(int i, string? text, double? start, double? end) { var cue = project!.Captions[i]; project.Captions[i] = new(text ?? cue.Text, start ?? cue.Start, end ?? cue.End); dirty = true; }
    void SetCueNumber(int i, string? value, bool start) { if (double.TryParse(value, CultureInfo.InvariantCulture, out var number)) SetCue(i, null, start ? number : null, start ? null : number); }
    Task SaveCaptions() => Action(async () => { CaptionFiles.Validate(project!.Captions, project.ActualSeconds); project.Steps[Stage.Captions].Output = Json.Write(project.Captions); project = await Projects.Edit(project, Stage.Captions, "Edit word captions"); message = Ui.T("Đã lưu phụ đề.", "Captions saved."); });
    Task Publish() => Action(async () => { await YouTube.Queue(Id, privacy, madeForKids, uploadApproved, lifetime.Token); uploadApproved = false; message = Ui.T("Upload đã vào hàng đợi. Theo dõi trong Chi phí & tác vụ.", "Upload queued. Follow progress under Costs & jobs."); });
    Task RetryThumbnail() => Action(async () => { await YouTube.SetThumbnail(project!, lifetime.Token); message = Ui.T("Đã gửi thumbnail.", "Thumbnail uploaded."); });
    Task Cancel(Guid id) => Action(() => Projects.Cancel(id));
    Task Resume(Guid id) => Action(() => Projects.Resume(id));
    void BeginReconcile(Guid id, decimal amount) { reconcileId = id; reconcileAmount = amount; reconcileApproved = false; }
    Task Reconcile() => Action(async () => { if (!reconcileApproved || reconcileId is null) throw new InvalidOperationException("Cần xác nhận đối soát."); await Projects.Reconcile(reconcileId.Value, reconcileAmount); reconcileId = null; message = Ui.T("Đã ghi nhận kết quả đối soát.", "Reconciliation recorded."); });
    Task Restore(Guid id) => Action(async () => { await Projects.Restore(Id, id); message = Ui.T("Đã khôi phục phiên bản.", "Version restored."); });
    public async ValueTask DisposeAsync() { lifetime.Cancel(); if (pollTask is not null) await pollTask; lifetime.Dispose(); }
}
