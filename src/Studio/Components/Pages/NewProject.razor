@page "/new"
@attribute [Authorize]
@inject ProjectService Projects
@inject NavigationManager Nav
<PageTitle>@Ui.T("Tạo video mới", "Create a video") · Frame Studio</PageTitle>
<div class="page-heading"><div><p class="eyebrow">CREATE SOMETHING NEW</p><h1>@Ui.T("Bắt đầu với một ý tưởng.", "Start with an idea.")</h1><p class="muted">@Ui.T("Anh quyết định câu chuyện. Studio chuẩn bị phần còn lại.", "You choose the story. Studio prepares the rest.")</p></div><a href="/" class="button secondary">← @Ui.T("Dự án", "Projects")</a></div>
@if (error is not null) { <div role="alert" class="alert error">@error</div> }
<form @onsubmit="Create" @onsubmit:preventDefault>
<div class="create-layout"><div class="form-stack">
    <section class="panel"><div class="panel-title"><span class="step-number">01</span><div><h2>@Ui.T("Câu chuyện của anh", "Your story")</h2><p>@Ui.T("Thêm định hướng để AI tạo đúng nội dung anh muốn.", "Give the AI a direction for the content you want.")</p></div></div><label>@Ui.T("Tên dự án", "Project name")<input required maxlength="160" @bind="project.Name" /></label><label>@Ui.T("Ý tưởng hoặc yêu cầu chọn chủ đề", "Topic idea or discovery brief")<textarea rows="4" placeholder="@Ui.T("Ví dụ: Những điều thú vị về đại dương ít người biết…", "For example: Fascinating things about the ocean…")" maxlength="12000" @bind="project.Brief"></textarea></label><div class="form-row"><label>@Ui.T("Đối tượng người xem", "Audience")<input @bind="project.Audience" /></label><label>@Ui.T("Phong cách", "Style")<input @bind="project.Style" /></label></div></section>
    <section class="panel"><div class="panel-title"><span class="step-number">02</span><div><h2>@Ui.T("Định dạng & ngôn ngữ", "Format & language")</h2><p>@Ui.T("Tối ưu cho cách người xem thưởng thức video.", "Designed for how your audience watches.")</p></div></div><div class="choice-grid"><button type="button" class="choice-card @(project.Format == VideoFormat.Short ? "selected" : "")" @onclick="() => Format(VideoFormat.Short)"><span class="format-icon portrait">▶</span><strong>YouTube Shorts</strong><small>9:16 · 15–180 @Ui.T("giây", "seconds")</small></button><button type="button" class="choice-card @(project.Format == VideoFormat.Long ? "selected" : "")" @onclick="() => Format(VideoFormat.Long)"><span class="format-icon landscape">▶</span><strong>@Ui.T("Video dài", "Long-form video")</strong><small>16:9 · 1–30 @Ui.T("phút", "minutes")</small></button></div><div class="form-row"><label>@Ui.T("Ngôn ngữ video", "Video language")<select @bind="project.Language"><option value="vi">🇻🇳 Tiếng Việt</option><option value="en">🇬🇧 English</option></select></label><label>@Ui.T("Thời lượng mục tiêu (giây)", "Target duration (seconds)")<input type="number" min="@(project.Format == VideoFormat.Short ? 15 : 60)" max="@project.MaxSeconds" @bind="project.TargetSeconds" /></label></div><div class="inline-note">1080p · H.264 / AAC · 30 fps <span>@Ui.T("Thời lượng thực được xác định sau khi tạo giọng đọc.", "Actual duration is measured after voice generation.")</span></div></section>
    <section class="panel"><div class="panel-title"><span class="step-number">03</span><div><h2>@Ui.T("Chế độ & ngân sách", "Workflow & budget")</h2><p>@Ui.T("Làm chủ từng quyết định và từng khoản chi.", "Stay in control of every decision and every cost.")</p></div></div><div class="form-row"><label>@Ui.T("Quy trình", "Workflow")<select @bind="project.Mode"><option value="Review">@Ui.T("Duyệt từng bước", "Review each step")</option><option value="Automatic">@Ui.T("Tự động đến bản dựng", "Automatic to final render")</option></select></label><label>@Ui.T("Tiền tệ", "Currency")<select @bind="project.Currency" @bind:after="CurrencyChanged"><option>USD</option><option>VND</option></select></label></div><div class="form-row"><label>@Ui.T("Trần ngân sách / video", "Budget limit / video")<input type="number" min="0" step="0.01" @bind="project.Budget" /></label>@if (project.Currency == "VND") { <label>@Ui.T("Tỷ giá VND / USD", "Exchange rate VND / USD")<input type="number" min="1" @bind="project.VndPerUsd" /></label> }</div><p class="help">@Ui.T("Bao gồm lần chạy lại, không gồm chi phí máy/VPS. Studio dừng trước bước vượt dự toán; hóa đơn provider là số tiền cuối cùng.", "Includes reruns, excludes your compute costs. Studio stops before exceeding the estimate; provider invoices are authoritative.")</p></section>
    <section class="panel"><div class="panel-title"><span class="step-number">04</span><div><h2>@Ui.T("Chọn đội ngũ AI", "Choose your AI toolkit")</h2><p>@Ui.T("Mỗi công đoạn, một provider phù hợp.", "The right provider for each stage.")</p></div></div><div class="segmented"><button type="button" class="@(preset == "free" ? "active" : "")" @onclick='() => Preset("free")'>☁ @Ui.T("Cloud miễn phí", "Free cloud")</button><button type="button" class="@(preset == "local" ? "active" : "")" @onclick='() => Preset("local")'>⌂ Self-hosted</button><button type="button" class="@(preset == "quality" ? "active" : "")" @onclick='() => Preset("quality")'>✦ @Ui.T("Chất lượng cao", "Premium")</button></div><div class="provider-picker">@foreach (var stage in Pipeline.Order) { <div class="provider-picker-row"><label for="provider-@stage">@Ui.StageName(stage)</label><select id="provider-@stage" value="@project.Steps[stage].ProviderId" @onchange="e => Choose(stage, e.Value?.ToString() ?? string.Empty)">@foreach (var provider in ProviderCatalog.For(stage)) { <option value="@provider.Id">@provider.Name · @Ui.Tier(provider.Tier)</option> }</select></div> }</div><p class="help">@Ui.T("Free tier có quota; sandbox có thể có watermark. Chưa cấu hình provider? Anh có thể thêm key/endpoint trong Cài đặt sau khi tạo dự án.", "Free tiers have quotas; sandboxes may watermark output. Add provider keys/endpoints in Settings after creating the project.")</p></section>
</div><aside class="creation-summary"><div class="panel sticky"><span class="eyebrow">YOUR NEXT VIDEO</span><div class="summary-art"><div class="summary-play">▶</div><span>@(project.Format == VideoFormat.Short ? "9 : 16" : "16 : 9")</span></div><h3>@project.Name</h3><dl><dt>@Ui.T("Định dạng", "Format")</dt><dd>@project.Format</dd><dt>@Ui.T("Ngôn ngữ", "Language")</dt><dd>@(project.Language == "vi" ? "Tiếng Việt" : "English")</dd><dt>@Ui.T("Thời lượng", "Duration")</dt><dd>@project.TargetSeconds s</dd><dt>@Ui.T("Ngân sách", "Budget")</dt><dd>@project.Budget.ToString("0.##") @project.Currency</dd><dt>@Ui.T("Công đoạn", "Stages")</dt><dd>10</dd></dl><button class="button primary full" disabled="@busy" type="submit">@(busy ? Ui.T("Đang tạo…", "Creating…") : Ui.T("Tạo dự án →", "Create project →"))</button><p class="help centered">@Ui.T("Tạo dự án chưa gọi API tính phí. Đăng YouTube luôn cần anh duyệt.", "Creating a project makes no paid calls. YouTube uploads always need your approval.")</p></div></aside></div>
</form>
@code {
    Project project = new(); string preset = "free"; string? error; bool busy;
    protected override void OnInitialized() => ProviderCatalog.ApplyPreset(project, preset);
    void Format(VideoFormat format) { project.Format = format; project.TargetSeconds = format == VideoFormat.Short ? 60 : 300; }
    void CurrencyChanged() => project.Budget = project.Currency == "VND" ? 125000 : 5;
    void Preset(string value) { preset = value; ProviderCatalog.ApplyPreset(project, value); }
    void Choose(Stage stage, string id) { project.Steps[stage].ProviderId = id; project.Steps[stage].Model = ProviderCatalog.Get(id).Model; }
    async Task Create() { busy = true; error = null; try { await Projects.Create(project); Nav.NavigateTo($"/studio/{project.Id}"); } catch (InvalidOperationException e) { error = e.Message; } finally { busy = false; } }
}
