@page "/providers"
@attribute [Authorize]
<PageTitle>Providers · Frame Studio</PageTitle>
<div class="page-heading"><div><p class="eyebrow">BUILD YOUR CREATIVE TOOLKIT</p><h1>@Ui.T("Đúng công cụ. Đúng câu chuyện.", "The right tools for your story.")</h1><p class="muted">@Ui.T("Kết hợp cloud và self-hosted theo cách của anh. Không tự đổi sang dịch vụ tính phí.", "Mix cloud and self-hosted tools your way. No automatic paid fallback.")</p></div><a class="button primary" href="/settings">@Ui.T("Quản lý kết nối", "Manage connections") ↗</a></div>
<div class="filter-bar"><select aria-label="Filter by stage" @bind="filter"><option value="all">@Ui.T("Tất cả công đoạn", "All stages")</option>@foreach (var stage in Pipeline.Order) { <option value="@stage">@Ui.StageName(stage)</option> }</select><span class="muted">@ProviderCatalog.All.Length @Ui.T("lựa chọn tích hợp", "integrated options")</span></div>
<div class="provider-grid">@foreach (var provider in ProviderCatalog.All.Where(p => filter == "all" || p.Stages.Any(s => s.ToString() == filter))) { <article class="provider-card"><div class="provider-card-top"><span class="provider-logo @provider.Tier.ToString().ToLowerInvariant()">@provider.Name[0]</span><span class="tier @provider.Tier.ToString().ToLowerInvariant()">@Ui.Tier(provider.Tier)</span></div><h2>@provider.Name</h2><div class="stage-chips">@foreach (var stage in provider.Stages) { <span>@Ui.StageName(stage)</span> }</div><p>@provider.Notice</p><a href="@($"/settings?provider={provider.Id}")">@Ui.T("Cấu hình kết nối", "Configure connection") <span>↗</span></a></article> }</div>
@code { string filter = "all"; }
